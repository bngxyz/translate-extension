{
  "manifest_version": 3,
  "name": "Quick Translate to Thai",
  "version": "1.0.0",
  "description": "คลุมข้อความแล้วกดไอคอนเพื่อแปลเป็นภาษาไทย (ตรวจจับภาษาอัตโนมัติ)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "https://challenges.cloudflare.com/*",
        "https://*.hcaptcha.com/*",
        "https://www.google.com/recaptcha/*",
        "https://recaptcha.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-translate-thai@bngxyxz.gmail.com",
      "strict_min_version": "121.0"
    }
  }
}
